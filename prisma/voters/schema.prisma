// ---------------------------------------------------------------------------
// RÖSTLÄNGDSDATABASEN (voters_db)
//
// Denna databas vet VEM som är röstberättigad och VEM som har röstat i vilken
// omröstning. Den vet aldrig VAD någon röstat på.
//
// Det finns ingen kolumn här som kan kopplas till en rad i Vote.
// Ingen token, inget token-hash, ingen röst-id, ingen parti-id, ingen
// kandidat-id.
//
// OM OMRÖSTNINGENS SPEGLING
//
// Election och ElectionBallot finns i BÅDA databaserna, med samma UUID. Det är
// en medveten dubblering, inte ett misstag: en foreign key mellan databaserna
// är fysiskt omöjlig, och alternativet — att röstlängden frågar röstdatabasen
// vilka omröstningar som finns — skulle kräva att den ena sidan kan läsa den
// andra. Speglingen gör att varje foreign key stannar inom sin egen databas.
//
// Vad speglingen kostar i anonymitet står i SECURITY.md, avsnittet om
// omröstnings-id som delad identifierare. Kort: med en enda omröstning ändrar
// den ingenting, med flera partitioneras rösterna och anonymitetsmängden
// krymper per omröstning.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/voters"
}

datasource db {
  provider = "postgresql"
  url      = env("VOTERS_DATABASE_URL")
}

/// En rad per röstberättigad person i röstlängden.
model VoterStatus {
  id String @id @default(uuid())

  /// HMAC-SHA256(personnummer, IDENTITY_PEPPER).
  /// Personnumret lagras aldrig i klartext. Peppret gör att en databasdump
  /// inte räcker för att brute-forca fram personnummer — utfallsrummet för
  /// svenska personnummer är litet nog att en ren SHA-256 skulle falla på
  /// sekunder.
  externalIdentityHash String @unique @map("external_identity_hash")

  isEligible Boolean @default(true) @map("is_eligible")

  /// Administratörsflagga.
  ///
  /// Adminbehörighet hänger på identiteten, inte på ett delat lösenord: den
  /// som ska kunna skapa en omröstning legitimerar sig med BankID precis som
  /// en väljare, och får adminvyn först om raden har flaggan satt.
  ///
  /// Flaggan sätts bara genom seed eller direkt i databasen. Det finns
  /// medvetet ingen väg i applikationen att ge sig själv eller någon annan
  /// admin — en sådan funktion vore den enskilt farligaste knappen i
  /// systemet.
  ///
  /// Notera vad flaggan INTE ger: adminvyn kan fortfarande inte se vem som
  /// röstat på vad, eftersom underlaget inte finns i någon databas den når.
  isAdmin Boolean @default(false) @map("is_admin")

  /// Var personen är folkbokförd. Avgör vilka kommun- och landstingsvalsedlar
  /// som gäller i ett riksdagsval — man röstar i sin egen kommun, inte i
  /// alla.
  ///
  /// Koderna ligger här och inte i röstdatabasen, just för att en geografisk
  /// markering bredvid en röst skulle krympa anonymitetsmängden dramatiskt i
  /// en liten kommun.
  municipalityCode String? @map("municipality_code")
  regionCode       String? @map("region_code")

  sessions       VotingSession[]
  adminSessions  AdminSession[]
  ballotStatuses VoterBallotStatus[]
  pendingVotes   PendingVote[]

  @@map("voter_status")
}

/// Spegling av en omröstning. Publik metadata, ingen rösträkning.
model Election {
  id String @id

  name String

  /// RIKSDAGSVAL | ALLMAN_OMROSTNING
  kind String

  opensAt  DateTime @map("opens_at")
  closesAt DateTime @map("closes_at")

  ballots ElectionBallot[]

  /// När kopplingen väljare↔röst raderades. Null medan röstningen pågår.
  linkClearedAt DateTime? @map("link_cleared_at")

  /// OPEN | CLOSED | VALIDATED | STRIPPED | TALLIED | CERTIFIED.
  ///
  /// Enkelriktad. Ordningen maste vara omojlig att kasta om, inte bara
  /// osannolik — se spec 6.1. Att fasen ar ett falt och inte en jamforelse mot
  /// klockan spelar roll: en klocka som gar fel andrar beteendet tyst, medan en
  /// fasovergang ar en handelse nagon utfort.
  phase String @default("OPEN")

  /// Merklerot över (ciphertextHash, bankIdSignature), beräknad före
  /// skalningen och skriven en enda gång.
  ///
  /// VAD DEN ÄR: ett åtagande publicerat INNAN kopplingen raderas. Den binder
  /// exakt den mängd kuvert som fanns när valet stängde — läggs ett kuvert
  /// till, ändras eller försvinner i efterhand blir roten en annan. Det är
  /// också det enda som överlever raderingen av signaturerna, eftersom
  /// underlaget den räknades över inte finns kvar efteråt.
  ///
  /// VAD DEN INTE ÄR: ett inklusionsbevis. En väljare kan i dag INTE visa att
  /// just hennes kuvert ingick — det kräver en inklusionsväg (syskonhasharna
  /// upp genom trädet), och `src/lib/merkle.ts` varken lagrar eller exporterar
  /// någon sådan. Efter skalningen är dessutom `bankIdSignature` raderad, så
  /// ingen utomstående kan räkna om roten över huvud taget. Se spec 7.3.
  envelopeRoot String? @map("envelope_root")

  @@map("election")
}

/// En valsedel i en omröstning.
///
/// I ett riksdagsval är det tre: kommun, landsting, riksdag. I en allmän
/// omröstning är det en per fråga administratören ställt.
///
/// Röstlängden speglar valsedlarna för att kunna hålla "har röstat" per
/// valsedel. Att ha röstat i riksdagsvalet men inte i kommunvalet är ett
/// fullt giltigt tillstånd i ett svenskt val, och en enda boolean per person
/// kan inte uttrycka det.
model ElectionBallot {
  id String @id

  electionId String   @map("election_id")
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  /// KOMMUN | LANDSTING | RIKSDAG | FRAGA
  kind String

  label String

  /// Bara satt för KOMMUN och LANDSTING: vilken kommun respektive region
  /// valsedeln gäller. Matchas mot väljarens folkbokföring.
  areaCode String? @map("area_code")

  /// Valmyndighetens signeringsnyckel för valsedelns röstintyg.
  ///
  /// EGET NYCKELPAR PER VALSEDEL, INTE PER OMRÖSTNING.
  ///
  /// Myndigheten signerar blint och ser alltså aldrig vilken valsedel intyget
  /// gäller. Bindningen måste därför komma från VILKEN NYCKEL som signerade:
  /// ett intyg för kommunvalsedeln verifierar helt enkelt inte mot
  /// riksdagsvalsedelns publika nyckel. Utan det skulle en väljare kunna
  /// begära tre intyg och lösa in alla tre på samma valsedel.
  ///
  /// Läcker den privata nyckeln kan vem som helst skapa röstintyg som ser
  /// auktoriserade ut. Den angriper alltså valets RIKTIGHET, till skillnad
  /// från IDENTITY_PEPPER som bär valhemligheten.
  signingPrivateKeyPem String @map("signing_private_key_pem")
  signingPublicKeyPem  String @map("signing_public_key_pem")

  displayOrder Int @map("display_order")

  voterStatuses VoterBallotStatus[]

  @@index([electionId])
  @@map("election_ballot")
}

/// "Har röstat", per person och valsedel.
///
/// Detta ersätter den tidigare booleanen på VoterStatus. Raden skapas först
/// när personen faktiskt röstat — frånvaro av rad betyder "har inte röstat".
model VoterBallotStatus {
  id String @id @default(uuid())

  voterStatusId String      @map("voter_status_id")
  voterStatus   VoterStatus @relation(fields: [voterStatusId], references: [id], onDelete: Cascade)

  ballotId String         @map("ballot_id")
  ballot   ElectionBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  /// AVSIKTLIGT GROVKORNIG: avrundad till dygn.
  ///
  /// Med millisekundsupplösning här och i Vote.createdAt skulle en
  /// angripare med båda databaserna kunna matcha rad mot rad på tid och
  /// därmed återskapa kopplingen mellan väljare och röst. Hela separationen
  /// vore då meningslös. Se SECURITY.md, avsnittet om tidskorrelation.
  votedAt DateTime @map("voted_at")

  /// Dubbelröstningsspärren. Att den ligger i databasen och inte i koden är
  /// avgörande: två samtidiga begäranden kan inte båda skapa raden.
  @@unique([voterStatusId, ballotId])
  @@index([ballotId])
  @@map("voter_ballot_status")
}

/// Kortlivad session mellan lyckad legitimering och lagd röst.
///
/// Detta är den ENDA punkt i systemet där en identitet och ett pågående
/// röstningsförsök existerar samtidigt. Raden raderas när alla valsedlar i
/// omröstningen är avklarade — efter det finns inget sessions-id kvar som kan
/// koppla ihop de två sidorna.
model VotingSession {
  id String @id @default(uuid())

  voterStatusId String      @map("voter_status_id")
  voterStatus   VoterStatus @relation(fields: [voterStatusId], references: [id], onDelete: Cascade)

  /// Vilken omröstning legitimeringen gäller.
  ///
  /// En session är knuten till en omröstning. Den som legitimerat sig för
  /// Valet 2026 kan inte återanvända sessionen för att rösta i en annan
  /// omröstning som råkar vara öppen samtidigt.
  electionId String @map("election_id")

  expiresAt DateTime @map("expires_at")

  /// CSRF-hemlighet knuten till sessionen (double-submit cookie).
  csrfSecret String @map("csrf_secret")

  @@index([voterStatusId])
  @@map("voting_session")
}

/// Session för en inloggad administratör.
///
/// Skild från VotingSession med flit. De två har olika livslängd, olika syfte
/// och olika risk, och en gemensam tabell med en `isAdmin`-kolumn skulle
/// innebära att ett fel i ett villkor kan förvandla en röstsession till en
/// adminsession.
///
/// ADMINSESSIONEN ÄR IDENTIFIERAD, OCH DET ÄR AVSIKTLIGT.
///
/// En väljares session raderas i samma stund rösten är lagd, just för att
/// ingen koppling ska finnas kvar. Här gäller det omvända: den som skapar en
/// omröstning SKA gå att knyta till en person, eftersom det är en
/// förvaltningsåtgärd som ska kunna granskas. Det är samtidigt ofarligt för
/// valhemligheten — adminsessionen ger tillgång till aggregat och metadata,
/// aldrig till någons röst, och underlaget för att koppla ihop dem finns inte
/// i någon databas adminvyn når.
model AdminSession {
  id String @id @default(uuid())

  voterStatusId String      @map("voter_status_id")
  voterStatus   VoterStatus @relation(fields: [voterStatusId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at")

  /// CSRF-hemlighet knuten till sessionen (double-submit cookie).
  csrfSecret String @map("csrf_secret")

  @@index([voterStatusId])
  @@map("admin_session")
}

/// En enhet som prenumererar på notiser om nya omröstningar.
///
/// INGEN KOPPLING TILL IDENTITET. Tabellen har medvetet ingen foreign key
/// till VoterStatus och inget identitetshash.
///
/// Skälet: en push-endpoint är i praktiken en enhetsidentifierare. Låg den
/// bredvid en identitet skulle en databasdump avslöja vilken telefon som hör
/// till vilken person — en helt ny avanonymiseringsyta, införd för en
/// bekvämlighetsfunktion. Notisen är därför en ren broadcast: systemet vet
/// att någon vill bli meddelad, inte vem.
///
/// Konsekvensen är att notiser går till alla prenumeranter, även icke
/// röstberättigade. Det är ett accepterat pris — meddelandet säger bara att en
/// omröstning öppnat, vilket är offentlig information ändå.
model PushSubscription {
  id String @id @default(uuid())

  endpoint String @unique

  /// Nycklarna från webbläsarens PushSubscription. De krypterar nyttolasten
  /// mot just den här enheten och är värdelösa för någon annan.
  p256dh String
  auth   String

  /// AVSIKTLIGT GROVKORNIG: avrundad till dygn, av samma skäl som votedAt.
  /// En exakt prenumerationstidpunkt skulle kunna korreleras mot en
  /// legitimeringstidpunkt om samma person gör båda strax efter varandra.
  createdAt DateTime @map("created_at")

  @@map("push_subscription")
}

/// Revisionslogg för säkerhetshändelser.
///
/// Innehåller ALDRIG: identitet, parti, kandidat, token, IP-adress,
/// request-id. Tidsstämpeln är avrundad till hel timme av samma skäl som
/// votedAt.
///
/// Detta är en medveten avvägning: en revisionslogg detaljerad nog att
/// utreda ett enskilt fall vore också detaljerad nog att avanonymisera en
/// väljare.
model AuditEvent {
  id         String   @id @default(uuid())
  eventType  String   @map("event_type")
  occurredAt DateTime @map("occurred_at")

  /// Löpnummer i den append-only kedjan, från 1.
  ///
  /// HÄR ÄR EN ORDNING OFARLIG, TILL SKILLNAD FRÅN BLAND RÖSTERNA.
  ///
  /// En ordnad revisionslogg avslöjar i vilken följd händelser inträffade —
  /// exempelvis att sex röstintyg utfärdades. Men rösterna är INTE ordnade:
  /// deras Merkleträd sorteras på innehåll och deras tidsstämplar är avrundade
  /// till timme. Att para ihop de två sidorna kräver ordning på BÅDA, och den
  /// finns inte att få.
  sequence Int @unique

  /// Föregående rads hash. Null bara för den första.
  previousHash String? @map("previous_hash")

  /// Den här radens hash, över löpnummer, händelsetyp, tidpunkt och
  /// föregående hash.
  ///
  /// Kedjan gör att en borttagen eller ändrad rad upptäcks: alla senare hashar
  /// slutar stämma. Den hindrar inte någon med databasåtkomst från att räkna om
  /// hela kedjan — skyddet mot det är att kedjans spets publiceras, se
  /// ElectionCommitment i röstdatabasen och observatörsgränssnittet.
  entryHash String @unique @map("entry_hash")

  @@index([eventType])
  @@map("audit_event")
}

/// Det yttre kuvertet: vem som röstat, plus ett chiffer systemet inte kan läsa.
///
/// RADEN ERSÄTTS NÄR VÄLJAREN ÄNDRAR SIG, och RADERAS när röstningen stänger.
/// Det är hela mekanismen mot röstköp: en köpare måste bevaka väljaren fram
/// till stängningen för att vara säker på vad som räknas.
///
/// Att kopplingen existerar under röstningen är ett medvetet byte mot den
/// tidigare konstruktionen, där den var fysiskt omöjlig. Se
/// docs/spec/2026-09-22-dubbla-kuvert.md avsnitt 9.
model PendingVote {
  id String @id @default(uuid())

  voterStatusId String      @map("voter_status_id")

  /// RESTRICT, INTE CASCADE.
  ///
  /// En struken väljares röst ska räknas (spec 7.4), så en radering får inte
  /// tyst ta rösten med sig. Restrict betyder att en väljare inte kan
  /// hårdraderas medan hon har en liggande röst. Efter skalningen är raden
  /// borta och raderingen fri igen.
  voterStatus   VoterStatus @relation(fields: [voterStatusId], references: [id], onDelete: Restrict)

  /// Speglat id. Ingen FK — valsedeln bor i den andra databasen.
  ballotId String @map("ballot_id")

  /// M par (c1, c2) som decimalsträngar.
  ciphertext Json

  /// M stycken 0/1-bevis plus ett summabevis.
  proofs Json

  /// SHA-256 över den kanoniska serialiseringen. Väljarens inklusionshandtag.
  ciphertextHash String @map("ciphertext_hash")

  /// Ökar vid varje läggning och ligger INUTI det signerade.
  ///
  /// Utan den kan den som fångat väljarens första signerade kuvert skicka in
  /// det igen efter att hon ändrat sig, och rösten återgår till den köpta.
  castSequence Int @map("cast_sequence")

  /// Väljarens egen signatur över kuvertet, från BankID /sign.
  bankIdSignature String @map("bankid_signature")

  /// Nyckelmaterialet ur certifikatet — INTE certifikatet självt.
  ///
  /// Certifikatet bär personnumret i klartext (attrappens radprefix, och
  /// subject-fältet i ett riktigt BankID-certifikat). Att lagra det i råform
  /// skulle sätta ett klartextpersonnummer bredvid identitetshashen i
  /// röstlängden och upphäva hela skälet att hasha. Det som behövs senare är
  /// bara nyckeln — för att kunna verifiera signaturen vid en framtida validering —
  /// och att underskrivaren var rätt person, vilket redan avgjorts av
  /// hashkontrollen vid läggningen och bärs av radens koppling till
  /// voterStatusId. Se `publicKeyFromCertificate` i `envelope-signature.ts`.
  bankIdPublicKey String @map("bankid_public_key")

  /// Dygnsupplöst, som all annan tidsdata i röstlängden.
  updatedAt DateTime @map("updated_at")

  @@unique([voterStatusId, ballotId])
  @@index([ballotId])
  @@map("pending_vote")
}
