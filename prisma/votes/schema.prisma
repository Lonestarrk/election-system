// ---------------------------------------------------------------------------
// DEN ANONYMA RÖSTDATABASEN (votes_db)
//
// Denna databas vet VAD som röstats på. Den vet aldrig VEM som röstat.
//
// Det finns ingen kolumn här som kan kopplas till en rad i voter_status.
// Ingen identitet, inget identitetshash, inget väljar-id, ingen IP-adress,
// inget sessions-id, inget request-id.
//
// Databasen ligger i en annan PostgreSQL-databas än röstlängden. En foreign
// key till voter_status är därför inte bara oskriven — den är omöjlig.
//
// OM VALSEDLAR OCH FÖRSKAPADE PARTIER
//
// Partiregistret är gemensamt och förskapat. Skälet är praktiskt snarare än
// kryptografiskt: skrevs partinamnet fritt per omröstning skulle
// "Socialdemokraterna" och "Socialdemokraterna " bli två partier i
// rösträkningen, och felet skulle upptäckas först när resultatet är fel.
// Vilka partier som faktiskt står på en viss valsedel avgörs av BallotParty.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/votes"
}

datasource db {
  provider = "postgresql"
  url      = env("VOTES_DATABASE_URL")
}

/// En omröstning. Samma UUID som speglingen i röstlängden.
model Election {
  id String @id @default(uuid())

  name String

  /// OPEN | UNDER_REVIEW.
  ///
  /// Fastställandet är fasen CERTIFIED i röstlängden, och
  /// fältet bär bara markeringen UNDER_REVIEW: en slutkontroll som hittar en
  /// avvikelse sätter den, och en markerad omröstning fastställs inte via
  /// gränssnittet. Se src/orchestration/final-check.usecase.ts. Den som kan
  /// skriva här kan ta bort markeringen, men inte få någon annan kontroll att
  /// passera med det.
  status String @default("OPEN")

  /// DEMO | SHARP: det läge omröstningen skapades i (uppgift 17).
  ///
  /// En server i skarpt läge vägrar läggning, stängning och fastställande i en
  /// DEMO-omröstning, och tvärtom. Utan det kunde demoröster hamna i ett skarpt val,
  /// och en demoomröstning kunde fastställas som riktig. Skapandet skriver läget
  /// ur serverns eget läge. Förvalet gäller bara rader som fanns före kolumnen, och
  /// alla databaser som fanns då var demodatabaser.
  mode String @default("DEMO")

  certifiedAt DateTime? @map("certified_at")

  /// RIKSDAGSVAL | ALLMAN_OMROSTNING
  ///
  /// Ett riksdagsval skapas med tre valsedlar — kommun, landsting, riksdag —
  /// där valen görs bland förskapade partier. En allmän omröstning skapas med
  /// de frågor administratören själv formulerar.
  kind String

  opensAt  DateTime @map("opens_at")
  closesAt DateTime @map("closes_at")

  ballots ElectionBallot[]

  /// Valets publika krypteringsnyckel, h = g^x.
  encryptionPublicKey String? @map("encryption_public_key")

  tallyCompletedAt DateTime? @map("tally_completed_at")

  trusteeShares TrusteeShare[]

  @@map("election")
}

/// En valsedel.
model ElectionBallot {
  id String @id @default(uuid())

  electionId String   @map("election_id")
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  /// KOMMUN | LANDSTING | RIKSDAG | FRAGA
  kind String

  label String

  /// Bara satt för KOMMUN och LANDSTING.
  ///
  /// Notera att koden står på VALSEDELN, inte på rösten. Vilken kommun en
  /// valsedel gäller är offentligt; vilken kommun en enskild röst kom från
  /// vore en geografisk markering bredvid ett partival, och i en liten kommun
  /// räcker det långt mot att peka ut någon.
  areaCode String? @map("area_code")

  /// Om väljaren får kryssa en kandidat utöver partiet (personröst).
  allowsCandidateVote Boolean @default(false) @map("allows_candidate_vote")

  displayOrder Int @map("display_order")

  parties BallotParty[]
  options BallotOption[]

  encryptedVotes     EncryptedVote[]
  partialDecryptions PartialDecryption[]
  tallies            BallotTally[]

  @@index([electionId])
  @@map("election_ballot")
}

/// Förskapat parti. Gemensamt register för alla omröstningar.
model Party {
  id           String @id @default(uuid())
  name         String @unique
  abbreviation String @unique
  /// Hex-färg för UI:t.
  color        String
  displayOrder Int    @map("display_order")

  ballots BallotParty[]

  @@map("party")
}

/// Ett parti som står på en viss valsedel.
///
/// Samma parti kan stå på flera valsedlar, och ett lokalt parti kan stå på
/// kommunvalsedeln utan att finnas i riksdagsvalet.
model BallotParty {
  id String @id @default(uuid())

  ballotId String         @map("ballot_id")
  ballot   ElectionBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  partyId String @map("party_id")
  party   Party  @relation(fields: [partyId], references: [id])

  displayOrder Int @map("display_order")

  candidates Candidate[]

  @@unique([ballotId, partyId])
  @@unique([ballotId, displayOrder])
  @@index([partyId])
  @@map("ballot_party")
}

/// En kandidat att kryssa för personröst.
///
/// PERSONRÖSTEN ÄR DEN KÄNSLIGASTE UPPGIFTEN I HELA SYSTEMET.
///
/// Ett partival delas med hundratusentals andra. Ett kryss på en kandidat som
/// fick elva röster i en kommun delas med tio. Kombinationen valsedel +
/// kandidat kan i praktiken vara nästan unik, och den som vet att en viss
/// person brukar kryssa en viss kandidat har därmed en gissning som är långt
/// bättre än slumpen.
///
/// Systemet lagrar därför aldrig kandidatkryss tillsammans med något som
/// smalnar av mängden ytterligare: ingen tidsstämpel finare än timme, ingen
/// geografisk markering på rösten, ingen ordningsföljd som går att sortera på.
/// Se SECURITY.md.
model Candidate {
  id String @id @default(uuid())

  ballotPartyId String      @map("ballot_party_id")
  ballotParty   BallotParty @relation(fields: [ballotPartyId], references: [id], onDelete: Cascade)

  name String

  displayOrder Int @map("display_order")

  @@unique([ballotPartyId, displayOrder])
  @@index([ballotPartyId])
  @@map("candidate")
}

/// Ett svarsalternativ på en FRAGA-valsedel i en allmän omröstning.
model BallotOption {
  id String @id @default(uuid())

  ballotId String         @map("ballot_id")
  ballot   ElectionBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  label String

  displayOrder Int @map("display_order")

  @@index([ballotId])
  @@map("ballot_option")
}

/// Det inre kuvertet, efter att identitetslagret skalats bort.
model EncryptedVote {
  /// HÄRLEDS UR KUVERTETS INNEHÅLL — SÄTTS ALDRIG AV DATABASEN.
  ///
  /// `urnIdFor` i `src/orchestration/close-election.usecase.ts` bygger id:t ur
  /// chifferhashen, valsedeln och ett löpnummer bland likadana kuvert i
  /// läsningens innehållsordning (fixrunda 3 av uppgift 11d, ruling 130). Id:t
  /// säger alltså ingenting om när kuvertet lades eller av vem, och samma
  /// läsning ger samma id:n, så en omkörning krockar på primärnyckeln i stället
  /// för att skapa dubbletter. Fram till rundan var id:t chifferhashens första
  /// 32 hextecken, och två kuvert med samma chiffer fick samma plats.
  ///
  /// Fältet har därför medvetet INGET `@default(uuid())`. Ett slumpat
  /// standardvärde hade tyst brutit den kopplingen för varje framtida
  /// insättningsväg som utelämnar id:t; utan default vägrar TypeScript i
  /// stället att kompilera en sådan väg.
  id String @id

  ballotId String         @map("ballot_id")
  ballot   ElectionBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  ciphertext Json
  proofs     Json

  /// INTE UNIK (fixrunda 3 av uppgift 11d, ruling 130). Två kuvert får ha
  /// samma chiffer, en valsedel och en kopia av den, och båda räknas. Det var
  /// det unika indexet här som gjorde att av två likadana kuvert gick bara det
  /// ena att flytta. Idempotensen bärs i stället av primärnyckeln.
  ciphertextHash String @map("ciphertext_hash")

  @@index([ballotId])
  @@index([ciphertextHash])
  @@map("encrypted_vote")
}

/// En förtroendemans andel av dekrypteringsnyckeln.
model TrusteeShare {
  id String @id @default(uuid())

  electionId String   @map("election_id")
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  trusteeIndex Int @map("trustee_index")

  /// g^{x_i}. Publik, och det som bevisen kontrolleras mot.
  publicShare String @map("public_share")

  /// x_i, skyddad. En andel i klartext här vore lika illa som ingen delning.
  encryptedShare String @map("encrypted_share")

  @@unique([electionId, trusteeIndex])
  @@map("trustee_share")
}

model PartialDecryption {
  id String @id @default(uuid())

  ballotId String         @map("ballot_id")
  ballot   ElectionBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  optionIndex  Int    @map("option_index")
  trusteeIndex Int    @map("trustee_index")
  value        String
  proof        Json

  @@unique([ballotId, optionIndex, trusteeIndex])
  @@map("partial_decryption")
}

model BallotTally {
  id String @id @default(uuid())

  ballotId String         @map("ballot_id")
  ballot   ElectionBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  optionIndex Int @map("option_index")
  count       Int

  @@unique([ballotId, optionIndex])
  @@map("ballot_tally")
}
