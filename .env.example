# ---------------------------------------------------------------------------
# Databaser
#
# TVÅ SEPARATA DATABASER. Detta är inte en stilfråga: en foreign key mellan
# två olika PostgreSQL-databaser är fysiskt omöjlig, vilket gör separationen
# mellan identitet och röst strukturellt garanterad i stället för en
# konvention som utvecklare lovat följa.
# ---------------------------------------------------------------------------

# Röstlängd / röstberättigande. Innehåller identiteter. Innehåller ALDRIG röster.
VOTERS_DATABASE_URL="postgresql://election:election@localhost:5432/voters_db?schema=public"

# Anonyma röster. Innehåller röster. Innehåller ALDRIG identiteter.
VOTES_DATABASE_URL="postgresql://election:election@localhost:5432/votes_db?schema=public"

# ---------------------------------------------------------------------------
# Kryptografi
# ---------------------------------------------------------------------------

# Peppar för HMAC-hashning av personnummer i röstlängden.
# Utan denna kan någon med databasdumpen brute-forca alla svenska personnummer
# (utfallsrummet är litet nog att uttömmande sökning tar sekunder).
# Byt ut i alla miljöer. Minst 32 tecken.
IDENTITY_PEPPER="byt-ut-mig-detta-ar-bara-for-lokal-utveckling-0000"

# ---------------------------------------------------------------------------
# Admin
#
# Ingen adminhemlighet här. Behörigheten avgörs av is_admin på personens rad i
# röstlängden, efter BankID-legitimering. Seed-skriptet flaggar en demoperson
# som administratör; se prisma/seed.ts.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Applikation
# ---------------------------------------------------------------------------
APP_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Sätt till "true" bakom HTTPS så att cookies får Secure-flaggan.
COOKIE_SECURE="false"

# MockBankID: hur många collect-anrop innan legitimeringen blir klar.
MOCK_BANKID_POLLS_UNTIL_COMPLETE="2"
