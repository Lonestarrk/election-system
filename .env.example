# ---------------------------------------------------------------------------
# Databaser
#
# TVÅ SEPARATA DATABASER. Detta är inte en stilfråga: en foreign key mellan
# två olika PostgreSQL-databaser är fysiskt omöjlig, vilket gör separationen
# mellan identitet och röst strukturellt garanterad i stället för en
# konvention som utvecklare lovat följa.
# ---------------------------------------------------------------------------

# Röstlängd / röstberättigande. Innehåller identiteter. Innehåller ALDRIG röster.
VOTERS_DATABASE_URL="postgresql://election:election@localhost:5432/voters_db?schema=public"

# Anonyma röster. Innehåller röster. Innehåller ALDRIG identiteter.
VOTES_DATABASE_URL="postgresql://election:election@localhost:5432/votes_db?schema=public"

# Testdatabaser. Integrationstesterna tömmer databasen de kör mot, så de kör
# aldrig mot adresserna ovan: tests/setup.ts byter ut databasnamnet mot
# voters_test respektive votes_test. Sätt de här bara om testerna ska ligga
# någon annanstans. Namnet måste sluta på _test, annars vägrar testerna köra.
# TEST_VOTERS_DATABASE_URL="postgresql://election:election@localhost:5432/voters_test?schema=public"
# TEST_VOTES_DATABASE_URL="postgresql://election:election@localhost:5432/votes_test?schema=public"
#
# Är en adress satt ska de databasberoende testerna köras, och svarar servern
# inte fallerar de — en stoppad container ska inte se ut som en grön körning.
# Ska testerna köras utan databas, sätt SKIP_DB_TESTS=1, helst i skalet för
# just den körningen. Bara "1" och "true" räknas.
# SKIP_DB_TESTS=1

# ---------------------------------------------------------------------------
# Kryptografi
# ---------------------------------------------------------------------------

# Peppar för identitetshashningen i röstlängden (scrypt, se lib/crypto.ts).
#
# DETTA ÄR DET FAKTISKA SKYDDET, inte hashfunktionens parametrar. Personnummer
# har ett litet utfallsrum (~4·10^7), så en hash vänds genom uppräkning — men
# bara av den som kan beräkna kandidathashar. Pepparn ligger inte i databasen
# och följer därför inte med en databasdump, och utan den är uppräkning inte
# dyr utan omöjlig.
#
# Följden: läcker pepparn ensam — via en loggrad, en stacktrace eller en
# CI-logg — är det allvarligare än det ser ut, och den kan inte roteras utan
# att röstlängden importeras om (vi lagrar inga personnummer i klartext).
# Byt ut i alla miljöer. Minst 32 tecken.
IDENTITY_PEPPER="byt-ut-mig-detta-ar-bara-for-lokal-utveckling-0000"

# ---------------------------------------------------------------------------
# Admin
#
# Ingen adminhemlighet här. Behörigheten avgörs av is_admin på personens rad i
# röstlängden, efter BankID-legitimering. Seed-skriptet flaggar en demoperson
# som administratör; se prisma/seed.ts.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Applikation
# ---------------------------------------------------------------------------
# Tillåtna origins för CSRF-kontrollen, kommaseparerade.
#
# Flera värden behövs oftare än man tror: localhost under utveckling plus
# maskinens LAN-adress när man provar från en telefon. Saknas en adress i
# listan avvisas varje POST därifrån med 403, och det ser ut som en trasig
# inloggning snarare än en felkonfiguration.
#
#   APP_ORIGIN="http://localhost:3000,http://192.168.1.88:3000"
APP_ORIGIN=
NODE_ENV="development"

# Sätt till "true" bakom HTTPS så att cookies får Secure-flaggan.
COOKIE_SECURE="false"

# MockBankID: hur många collect-anrop innan legitimeringen blir klar.
MOCK_BANKID_POLLS_UNTIL_COMPLETE="2"

# ---------------------------------------------------------------------------
# Push-notiser (Web Push / VAPID)
#
# Frivilliga. Saknas de är notiser avstängda och systemet fungerar i övrigt
# precis som vanligt.
#
# Generera ett par med:
#   npx web-push generate-vapid-keys
#
# Den privata nyckeln signerar utskicken och identifierar avsändaren mot
# push-tjänsterna. Läcker den kan någon annan skicka notiser i systemets namn,
# vilket vore ett trovärdigt sätt att lura väljare till en falsk sajt.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:valmyndigheten@example.org"
